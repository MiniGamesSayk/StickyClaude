# StickyClaude : variables d'environnement du serveur (toutes facultatives, les valeurs ci-dessous
# sont les valeurs par défaut sûres sauf mention contraire). Documentation : docs/DEPLOIEMENT.md.
# Sur le VPS, ce fichier devient ~/apps/games/stickyclaude/.env (chmod 600) ; la plateforme passe
# toutes ses variables au conteneur (MEM_LIMIT et CPUS servent à la plateforme elle-même).

# --- Plateforme (lues par « games », pas par le jeu) ---
MEM_LIMIT=512m
CPUS=1.0

# --- Réseau ---
PORT=3000
HOST=0.0.0.0
# Origine publique du site : seule origine acceptée pour le WebSocket et pour la CSP.
# Vide : l'origine de la page doit être celle de l'en-tête Host (même site). À renseigner en production.
PUBLIC_ORIGIN=https://stickyclaude.sayk.fr
# Proxys dont on croit X-Forwarded-For : « caddy » (réseaux privés dont Docker) ou une liste
# d'adresses et de CIDR. Vide : l'en-tête est ignoré (tous les joueurs auraient l'IP du proxy).
TRUSTED_PROXY=caddy
# Jeton pour lire /metrics depuis l'extérieur (Authorization: Bearer ...). Vide : /metrics n'est
# lisible que depuis l'intérieur (réseau privé, sans passer par Caddy).
METRICS_TOKEN=

# --- Capacité ---
# Valeurs par défaut du code : 40 salons, 400 connexions (le budget de l'analyse : 25 salons × 8
# joueurs). Mesuré sur le VPS (1 CPU d'un Xeon 2,3 GHz partagé avec Caddy et les autres jeux), les
# budgets ne tiennent que jusqu'à ~ 12 salons : voir docs/DEPLOIEMENT.md § Charge. Sur le VPS :
MAX_ROOMS=12
MAX_CONNECTIONS=120
MAX_CONN_PER_IP=8
# Instantanés par seconde et par joueur : 10, 12, 15, 20, 30 ou 60 (diviseurs de 60 Hz ; une autre
# valeur est ramenée à la plus proche, de sorte que la fréquence annoncée au client est la vraie).
SNAPSHOT_HZ=30

# --- Limites de débit (par IP et par minute) ---
CREATE_PER_MIN=3
CODE_TRIES_PER_MIN=10

# --- Salons ---
RECONNECT_GRACE_MS=20000
AUTOSTART_MS=20000
ROOM_IDLE_TTL_SEC=300
HEARTBEAT_MS=10000
IDLE_PLAYING_MS=60000
IDLE_LOBBY_MS=600000
MATCH_END_MS=12000
VOTE_MS=12000
VOTE_DEFAULT=1
EMOTE_COOLDOWN_MS=3000
CONTROL_PER_SEC=20

# --- Arrêt propre ---
# Délai donné aux joueurs en cours de partie après SIGTERM (s), puis fermeture (code 1012).
# La plateforme laisse 10 s à Docker par défaut : tant que le générateur n'ajoute pas
# stop_grace_period: 35s (cas de la production : 30 s pour le serveur, 35 s pour Docker),
# garder SHUTDOWN_GRACE_SEC ≤ 30 ; sans ce réglage Docker tue au bout de 10 s : mettre 8.
SHUTDOWN_GRACE_SEC=30

# --- Comptes sayk.fr (connexion Discord) ---
# Service `auth` du hub (dépôt ClaudeGame). Vides : le jeu reste anonyme, rien ne change.
# SAYK_AUTH_URL : adresse interne sur le réseau Docker « web ». SAYK_AUTH_KEY : le secret de ce jeu,
# le même que « stickyclaude » dans GAME_KEYS du .env du hub. SAYK_API_ORIGIN : ouvre la CSP vers l'API.
SAYK_AUTH_URL=http://auth:3000
SAYK_AUTH_KEY=
SAYK_API_ORIGIN=https://api.sayk.fr

# --- Journaux ---
# trace, debug, info, warn, error, fatal ou silent. JSON sur la sortie standard.
LOG_LEVEL=info

# --- Développement uniquement (ne jamais activer en production) ---
# DEV_TOOLS=1
# RECORD_DIR=/tmp/recordings
# ALLOW_NO_ORIGIN=1
